{
  "name": "PassHub.net",
  "version": "1.8.0",
  "description": "Securely autofill login forms and payment details with PassHub password manager, built using zero-trust architecture. Supports Passkey (WebAuthn).",
  "author": "WWPass",
  "homepage_url": "https://wwpass.com",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "https://*/",
    "http://*/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "externally_connectable": {
    "matches": [
      "https://passhub.com/*",
      "https://passhub.net/*",
      "https://passhub.ch/*",
      "https://passhub.us/*",
      "https://passhub.eu/*",
      "https://*.passhub.com/*",
      "https://*.passhub.net/*",
      "https://*.passhub.ch/*",
      "https://*.passhub.us/*",
      "https://*.passhub.eu/*"
    ]
  },
  "action": {
    "default_icon": {
      "48": "images/passhub-logo-48.png",
      "128": "images/passhub-logo-128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "images/passhub-logo-48.png",
    "128": "images/passhub-logo-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["contentScript.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["passkeyInterceptor.js", "passhubBridge.js", "popup.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "key": "",
  "manifest_version": 3
}